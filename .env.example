APP_NAME="Keystone.guru"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_DISCORD_WEBHOOK=
APP_URL=http://localhost:8008
APP_TYPE=local
APP_LOCALE=en_US
APP_FALLBACK_LOCALE=en_US
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=debug

AUTH_PASSWORD_RESET_TOKEN_TABLE=password_resets

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10
DEBUGBAR_ENABLED=false
FILESYSTEM_DISK=s3_user_uploads

OCTANE_SERVER=swoole

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keystone.guru.dev
DB_USERNAME=homestead
DB_PASSWORD=secret
# Docker MySQL data dir variant: empty for local data (docker-compose/mysql*), -prod for the prod
# data copies (docker-compose/mysql-prod*). Recreate with `docker compose up -d db db-combatlog`.
#DB_DATA_VARIANT=-prod

DB_CONNECTION_MIGRATE=migrate
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
DB_BACKUP_DIR=

DB_PHPUNIT_DATABASE=
DB_PHPUNIT_USERNAME=
DB_PHPUNIT_PASSWORD=
# Optional: dedicated combatlog schema for the test suite. When set, Tests\TestCase redirects the
# combatlog connection to it so tests never touch the live combatlog schema (#4346). Provision
# both phpunit schemas with sh/provision-phpunit-db.sh.
DB_PHPUNIT_COMBATLOG_DATABASE=

DB_COMBATLOG_HOST=127.0.0.1
DB_COMBATLOG_PORT=3306
DB_COMBATLOG_DATABASE=keystone.guru.combatlog
DB_COMBATLOG_USERNAME=homestead
DB_COMBATLOG_PASSWORD=secret

OPENSEARCH_HOST=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_SSL_VERIFICATION=

COMBATLOG_DIR=
MAPPING_BACKUP_DIR=
ASSETS_BASE_URL=https://assets.keystone.guru
# Must be accessible from inside Docker containers
ASSETS_BASE_URL_INTERNAL=https://assets.keystone.guru

TELESCOPE_ENABLED=false

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
QUEUE_CONNECTION=redis

# A secret string that must be provided in order to gain access to the preview image
THUMBNAIL_PREVIEW_SECRET=secret

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where we can find Reverb (for PHP / broadcasters / clients inside Docker)
REVERB_HOST="reverb"
REVERB_PORT=6001
REVERB_SCHEME=http
# Where Reverb is hosted (what it binds to)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

MIX_REVERB_APP_KEY="${REVERB_APP_KEY}"
MIX_REVERB_HOST="${REVERB_HOST}"
MIX_REVERB_PORT="${REVERB_PORT}"
MIX_REVERB_SCHEME="${REVERB_SCHEME}"

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=keystoneguru-local-cache:
REDIS_CACHE_DB=2
REDIS_SCHEME=tcp
REDIS_CLIENT=phpredis

MODEL_CACHE_ENABLED=false
MODEL_CACHE_STORE=redis_model_cache
MODEL_CACHE_FALLBACK_TO_DB=true
REDIS_DB_MODEL_CACHE=1
REDIS_DB_SESSION=3

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# Intentionally 'log' rather than 'mailgun' locally, so mail lands in the log instead of being sent through the
# real Mailgun account. Set to 'mailgun' for a session to actually test the integration.
MAIL_DRIVER=log
#MAIL_HOST=mailtrap.io
#MAIL_PORT=2525
#MAIL_USERNAME=null
#MAIL_PASSWORD=null
MAIL_SCHEME=null

MAILGUN_DOMAIN=keystone.guru
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

URL_HOST=http://localhost:8008

PATREON_CLIENT_ID=
PATREON_SECRET=
PATREON_CAMPAIGN_ID=

GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

BATTLE_NET_SIGNIN_CLIENT_ID=
BATTLE_NET_SIGNIN_CLIENT_SECRET=

DISCORD_SIGNIN_CLIENT_ID=
DISCORD_SIGNIN_CLIENT_SECRET=
DISCORD_NEW_RELEASE_WEBHOOK=
DISCORD_GITHUB_WEBHOOK=

GITHUB_ACCESS_TOKEN=
GITHUB_WEBHOOK_SECRET=

RAIDERIO_WEBHOOK_USER=
RAIDERIO_WEBHOOK_PASSWORD=
RAIDERIO_API_KEY=
RAIDERIO_USE_LOCAL_MOCK_SERVICE=

# Base URLs of the other keystone.guru deployments that local tooling (combatlog:importenemyfailures --host=...) pulls from.
# Leave empty for the defaults (https://keystone.guru / https://staging.keystone.guru).
KSG_REMOTE_PRODUCTION_URL=
KSG_REMOTE_STAGING_URL=

PLAYWIRE_PARAM_1=
PLAYWIRE_PARAM_2=

LAREX_CROWDIN_TOKEN=
LAREX_CROWDIN_PROJECT_ID=

ROLLBAR_CLIENT_ACCESS_TOKEN=
ROLLBAR_SERVER_ACCESS_TOKEN=

CLOUDFLARE_ID=

AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_USER_UPLOADS_REGION=
AWS_S3_BUCKET_USER_UPLOADS=
AWS_S3_BUCKET_USER_UPLOADS_URL=

AWS_S3_BUCKET_HOTFIXES_REGION=
AWS_S3_BUCKET_HOTFIXES=

AWS_S3_BUCKET_COMBAT_LOGS_REGION=
AWS_S3_BUCKET_COMBAT_LOGS=
AWS_USE_PATH_STYLE_ENDPOINT=false

SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=production-default

SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=true
# Spans are metered separately from errors; tracing is disabled so the span budget is not spent on data
# that gets dropped anyway. Note SENTRY_TRACE_QUEUE_ENABLED defaults to true, which makes every queued job
# a transaction.
SENTRY_TRACES_SAMPLE_RATE=0
# Both default to the version file and APP_TYPE respectively, so these only need setting to override that
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=

COMBAT_LOG_ROUTE_REGENERATION_USER=
COMBAT_LOG_ROUTE_REGENERATION_PASSWORD=

# Set high locally so combat-log-derived data is never accidentally pruned during development
COMBAT_LOG_STALENESS_OBSERVATION_WINDOW_DAYS=3
COMBAT_LOG_STALENESS_OBSERVATION_RETENTION_DAYS=30

<div class="row g-0">
    <div class="col btn
        {{#ifCond btnType '!=' '' }}
        {{ btnType }}
    {{else}}
            btn-info
        {{/ifCond}}
        ">
        <div class="row g-0">
            <div class="col-auto">
                <i class="fas {{ fa_class }}" aria-hidden="true"></i>
            </div>
            <div class="col">
                <span class="map_controls_element_label_toggle" style="display: none;">
                    {{ text }}
                </span>
            </div>
        </div>
        {{#if hotkey}}
            <kbd class="draw_tool_keycap" aria-hidden="true">{{ hotkey }}</kbd>
        {{/if}}
    </div>
</div>

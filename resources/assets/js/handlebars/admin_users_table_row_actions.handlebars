<div class="dropdown">
    <button class="btn btn-secondary dropdown-toggle" type="button" id="userActionsButton" data-bs-toggle="dropdown"
            aria-haspopup="true" aria-expanded="false">
        {{t 'actions_label'}}
    </button>
    <div class="dropdown-menu" aria-labelledby="userActionsButton">
        {{#each roles}}
            <a class="dropdown-item" href="#">
                <button type="button" class="btn w-100 user_toggle_role {{#if removable}}btn-warning{{else}}btn-info{{/if}}"
                        data-user-id="{{../user.id}}" data-user-name="{{../user.name}}" data-role="{{name}}" data-grant="{{#if removable}}0{{else}}1{{/if}}">
                    {{#if removable}}{{t 'remove_label'}}{{else}}{{t 'make_label'}}{{/if}} {{display_name}}
                </button>
            </a>
        {{/each}}
        <div class="dropdown-divider"></div>
        <a class="dropdown-item" href="#">
            <form method="POST" action="/admin/user/{{user.id}}/delete" accept-charset="UTF-8"
                  autocomplete="off">
                <input name="_method" type="hidden" value="DELETE">
                <input name="_token" type="hidden" value="{{csrf_token}}">
                <input class="btn btn-danger w-100" name="submit" type="submit" value="{{t 'delete_user_label'}}">
            </form>
        </a>
        <div class="dropdown-divider"></div>
        <a class="dropdown-item" href="#"
           data-bs-toggle="modal" data-bs-target="#user_ip_addresses_modal"
           data-ip-addresses="{{user.ip_addresses_string}}"
        >
            {{t 'view_ip_addresses_label'}}
        </a>
        <a class="dropdown-item" href="#"
           data-bs-toggle="modal" data-bs-target="#grant_all_benefits_modal"
           data-user-id="{{user.id}}"
           data-user-name="{{user.name}}"
        >
            {{t 'grant_all_benefits_label'}}
        </a>
    </div>
</div>

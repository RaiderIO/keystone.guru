<div class="thumbnail-carousel">
    <ul class="thumbnail-carousel__track {{#ifCond items.length '==' 1}} single {{else}} multiple {{/ifCond}}">
        {{#items}}
        <li class="thumbnail-carousel__slide">
            <img class="thumbnail" data-src="{{src}}" src="//:0"/>
        </li>
        {{/items}}
    </ul>
</div>

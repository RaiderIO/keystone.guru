<div class="row g-0">
    <div class="col-auto">
        <i class="fas fa-eye" data-bs-toggle="tooltip" title="{{t 'views_tooltip_label'}}"></i>
    </div>
    <div class="col ms-1">
        <span class="views" title="{{views_exact}}">{{views}}/{{views_embed}}</span>
    </div>
</div>
<div class="row g-0">
    <div class="col-auto">
        <i class="fas fa-copy" data-bs-toggle="tooltip" title="{{t 'copy_tooltip_label'}}"></i>
    </div>
    <div class="col ms-1">
        <span class="copies" title="{{copy_exact}}">{{copy_view}}/{{copy_embed}}</span>
    </div>
</div>

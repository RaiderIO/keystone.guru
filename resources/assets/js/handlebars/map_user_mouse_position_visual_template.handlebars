<div class="inner echo_user_{{public_key}} text-center" style="width: {{width}}px; height: {{height}}px;">
    {{#ifCond avatar_url '==' null}}
        <div class="user_mouse_position_initials" style="font-size: {{fontSize}}px;">{{initials}}</div>
    {{else}}
        <img src="{{avatar_url}}" alt="{{initials}}"
             style="width: calc({{width}}px - 6px); height: calc({{height}}px - 6px);"/>
    {{/ifCond}}
</div>
